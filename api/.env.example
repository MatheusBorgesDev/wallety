DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/wallety?schema=public"
PORT=3000
# At least 32 characters. Generate one with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET="CHANGE_ME"
# Signs access tokens. At least 32 characters, different from the one above.
JWT_SECRET="CHANGE_ME"
# Optional. Seconds an access token lasts (default 7200).
# ACCESS_TOKEN_TTL_SECONDS=7200
# Optional. Browser origins allowed to call the API, comma separated (default: none).
# CORS_ORIGINS="http://localhost:5173"
# Optional. Number of reverse proxies in front of the API, so rate limits see the client address.
# TRUST_PROXY=1
# Optional. Base URL of the delivery process, told about each posted transfer. Leave unset when
# that process polls on its own (WORKER_POLL_INTERVAL_MS), as in docker-compose.
# DISPATCH_URL="http://localhost:3001"
# DISPATCH_AUTH="none"   # or "google-id-token" for a private Cloud Run service
