// Prisma schema — Wallety API
// Constraints, triggers and privileges that Prisma cannot express live in the SQL migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Emit relative imports with the .js extension so the compiled output runs on plain Node ESM.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SandboxKind {
  DEMO
  REGISTERED
}

enum AccountKind {
  USER
  SYSTEM
}

enum TransferStatus {
  POSTED
}

enum OutboxStatus {
  PENDING
  DELIVERED
  FAILED
}

// The unit of isolation and of cleanup: users only transact inside their own sandbox,
// so a sandbox can be removed as a whole without unbalancing anyone else's ledger.
model Sandbox {
  id                   String           @id @default(uuid())
  kind                 SandboxKind
  expiresAt            DateTime?
  // How many of the next webhook deliveries the built-in receiver must refuse, so that
  // retries can be observed. Only the receiver reads and decrements it.
  receiverFailuresLeft Int              @default(0)
  createdAt            DateTime         @default(now())
  users                User[]
  accounts             Account[]
  outboxEvents         OutboxEvent[]
  webhookReceipts      WebhookReceipt[]

  @@map("sandboxes")
}

model User {
  id           String     @id @default(uuid())
  sandboxId    String
  // Null for users that cannot log in, such as the counterpart of a demo sandbox.
  email        String?    @unique
  passwordHash String?
  displayName  String
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  sandbox      Sandbox    @relation(fields: [sandboxId], references: [id])
  accounts     Account[]
  transfers    Transfer[]

  @@index([sandboxId])
  @@map("users")
}

model Account {
  id        String        @id @default(uuid())
  kind      AccountKind   @default(USER)
  name      String
  currency  String        @db.Char(3)
  // Both null for a SYSTEM account, both set for a USER account (enforced by a CHECK constraint).
  userId    String?
  sandboxId String?
  createdAt DateTime      @default(now())
  user      User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  sandbox   Sandbox?      @relation(fields: [sandboxId], references: [id], onDelete: Restrict)
  entries   LedgerEntry[]

  @@index([userId])
  @@index([sandboxId])
  @@map("accounts")
}

model Transfer {
  id               String         @id @default(uuid())
  // The idempotency key is unique per scope (the requesting user, or "system"),
  // so one user can neither collide with nor probe another user's keys.
  idempotencyScope String
  idempotencyKey   String
  // Hash of the request, to detect a key reused with a different payload.
  requestHash      String
  status           TransferStatus @default(POSTED)
  createdByUserId  String?
  createdAt        DateTime       @default(now())
  createdBy        User?          @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  entries          LedgerEntry[]
  outboxEvent      OutboxEvent?

  @@unique([idempotencyScope, idempotencyKey])
  @@index([createdByUserId])
  @@map("transfers")
}

model LedgerEntry {
  id         String   @id @default(uuid())
  transferId String
  accountId  String
  // Signed, in minor units: negative is a debit, positive is a credit.
  amount     BigInt
  currency   String   @db.Char(3)
  createdAt  DateTime @default(now())
  transfer   Transfer @relation(fields: [transferId], references: [id])
  account    Account  @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt, id])
  @@index([transferId])
  @@map("ledger_entries")
}

// Transactional outbox: one event per posted transfer, written in the same transaction as
// the ledger entries. A separate process delivers it over HTTP and records the outcome.
model OutboxEvent {
  // The event id. Receivers deduplicate on it; it never changes between delivery attempts.
  id            String       @id @default(uuid())
  type          String
  transferId    String       @unique
  sandboxId     String
  // The exact request body, stored once so every attempt sends and signs the same bytes.
  payload       String
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime     @default(now())
  transfer      Transfer     @relation(fields: [transferId], references: [id], onDelete: Restrict)
  sandbox       Sandbox      @relation(fields: [sandboxId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([sandboxId, createdAt])
  @@map("outbox_events")
}

// What the built-in webhook receiver accepted. One row per event id: a repeated
// delivery of the same event only increases the counter.
model WebhookReceipt {
  eventId      String   @id
  sandboxId    String
  type         String
  firstAttempt Int
  deliveries   Int      @default(1)
  receivedAt   DateTime @default(now())
  sandbox      Sandbox  @relation(fields: [sandboxId], references: [id], onDelete: Restrict)

  @@index([sandboxId])
  @@map("webhook_receipts")
}

// Fixed-window counters for rate limiting, kept in the database so a limit holds across
// instances and restarts.
model RateLimitHit {
  // What is being limited, already hashed where it derives from personal data.
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_hits")
}
