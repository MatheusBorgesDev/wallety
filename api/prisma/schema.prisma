// Prisma schema — Wallety API
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Emit relative imports with the .js extension so the compiled output runs on plain Node ESM.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id        String        @id @default(uuid())
  userId    String
  currency  String
  createdAt DateTime      @default(now())
  entries   LedgerEntry[]

  @@map("accounts")
}

model Transfer {
  id             String        @id @default(uuid())
  idempotencyKey String        @unique
  status         String
  createdAt      DateTime      @default(now())
  entries        LedgerEntry[]

  @@map("transfers")
}

model LedgerEntry {
  id         String   @id @default(uuid())
  transferId String
  accountId  String
  amount     BigInt
  currency   String
  createdAt  DateTime @default(now())
  transfer   Transfer @relation(fields: [transferId], references: [id])
  account    Account  @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("ledger_entries")
}
